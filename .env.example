# Any OpenAI-compatible endpoint works. Pick one block.

# HFee (local, free, no key) - github.com/hostfog/hfee
AI_BASE_URL=http://127.0.0.1:11500/v1
AI_API_KEY=
AI_MODEL=qwen2.5:0.5b

# Ollama (local, free, no key)
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2

# OpenRouter (free models end in :free)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_MODEL=<model-id>:free

# Groq (free tier)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=<model-id>

# Google Gemini (free tier)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=...
# AI_MODEL=<model-id>

PORT=3001
HOST=127.0.0.1

# Accounts and limits
ALLOW_SIGNUP=true
DAILY_MESSAGES=200
DB_PATH=data/hfee.db

# Requests the model handles at once; others wait in line (match HFEE_NUM_PARALLEL)
MAX_PARALLEL=4

# Optional engines (deploy/engines.sh sets these up on a server).
# Each feature turns on when its settings are present.
# VISION_BASE_URL=http://127.0.0.1:8092/v1   # llama.cpp server with a vision model
# VISION_MODEL=qwen2.5-vl
# WHISPER_URL=http://127.0.0.1:8091          # whisper.cpp server (voice input)
# PIPER_BIN=/opt/hfee-engines/py/bin/piper   # read aloud
# PIPER_VOICE=/var/lib/hfee/engines/en_GB-alba-medium.onnx
# SD_BIN=/opt/hfee-engines/bin/sd-cli            # stable-diffusion.cpp (image generation)
# SD_MODEL=/var/lib/hfee/engines/sdxl_lightning_4step.safetensors
# SD_SIZE=768
# SD_STEPS=4
# SD_CFG=1
# SD_SAMPLER=euler
# SD_SCHEDULER=sgm_uniform
# SD_TYPE=q8_0                               # less memory (servers under 16 GB)
# SEARXNG_URL=http://127.0.0.1:8093          # web search
# SANDBOX_PYTHON=/opt/hfee-engines/py/bin/python  # run Python in a bubblewrap sandbox
